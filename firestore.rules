rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPassToken(token) {
      return token is string && token.size() >= 16 && token.size() <= 64 && token.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStageId(stageId) {
      return stageId in ['stage_1', 'stage_2', 'stage_3'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidSubId(subId) {
      return subId is string && subId.size() == 32 && subId.matches('^sub_[a-f0-9]{28}$');
    }

    function isAdmin() {
      return isVerified() && (
        (request.auth.token.email is string && request.auth.token.email.lower() == 'waadpc90@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidEmailKey(val) {
      return val is string &&
        val.size() >= 5 &&
        val.size() <= 120 &&
        val.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidHex64(val) {
      return val is string && val.size() == 64 && val.matches('^[a-f0-9]{64}$');
    }

    function isValidHex32(val) {
      return val is string && val.size() == 32 && val.matches('^[a-f0-9]{32}$');
    }

    function isSchoolOwner(schoolId) {
      return isVerified() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
    }

    function isSchoolStaff(schoolId) {
      return isVerified() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/staffMembers/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/staffMembers/$(request.auth.token.email.lower())).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/staffMembers/$(request.auth.token.email.lower())).data.ownerId == schoolId;
    }

    function hasSchoolAccess(schoolId) {
      return isSchoolOwner(schoolId) || isSchoolStaff(schoolId) || isAdmin();
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptionalDateString(val) {
      return val is string && (val.size() == 0 || (val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function isValidPhone(val) {
      return val is string && val.size() <= 24 && val.matches('^[0-9+\\-\\s]*$');
    }

    function isValidStageNamesMap(m) {
      return m is map &&
        m.keys().hasAll(['stage_1', 'stage_2', 'stage_3']) &&
        m.keys().hasOnly(['stage_1', 'stage_2', 'stage_3']) &&
        m.stage_1 is string && m.stage_1.size() >= 1 && m.stage_1.size() <= 60 &&
        m.stage_2 is string && m.stage_2.size() >= 1 && m.stage_2.size() <= 60 &&
        m.stage_3 is string && m.stage_3.size() >= 1 && m.stage_3.size() <= 60;
    }

    function isValidStageTokensMap(m) {
      return m is map &&
        m.keys().hasAll(['stage_1', 'stage_2', 'stage_3']) &&
        m.keys().hasOnly(['stage_1', 'stage_2', 'stage_3']) &&
        isValidPassToken(m.stage_1) &&
        isValidPassToken(m.stage_2) &&
        isValidPassToken(m.stage_3);
    }

    function isValidSubjectsList(items) {
      return items is list &&
        items.size() >= 1 &&
        items.size() <= 30 &&
        items[0] is string &&
        items[0].size() >= 1 &&
        items[0].size() <= 80 &&
        items[items.size() - 1] is string &&
        items[items.size() - 1].size() >= 1 &&
        items[items.size() - 1].size() <= 80;
    }

    function isValidLatestAlert(alert) {
      return alert is map &&
        alert.keys().hasAll(['id', 'kind', 'title', 'body', 'createdAtIso']) &&
        alert.keys().hasOnly([
          'id', 'kind', 'title', 'body', 'createdAtIso',
          'imageScope', 'imageScopeToken', 'imageMediaId', 'imageCaption'
        ]) &&
        alert.id is string && alert.id.size() >= 1 && alert.id.size() <= 64 &&
        alert.kind in ['grades', 'attendance', 'summary', 'announcement', 'urgent'] &&
        alert.title is string && alert.title.size() >= 1 && alert.title.size() <= 140 &&
        alert.body is string && alert.body.size() >= 1 && alert.body.size() <= 500 &&
        alert.createdAtIso is string && alert.createdAtIso.size() >= 1 && alert.createdAtIso.size() <= 40 &&
        (!('imageScope' in alert) || alert.imageScope in ['stage', 'pass']) &&
        (!('imageScopeToken' in alert) || isValidPassToken(alert.imageScopeToken)) &&
        (!('imageMediaId' in alert) || isValidId(alert.imageMediaId)) &&
        (!('imageCaption' in alert) || (alert.imageCaption is string && alert.imageCaption.size() <= 140));
    }

    function isValidStageBroadcast(b) {
      return b is map &&
        b.keys().hasAll(['id', 'kind', 'title', 'body', 'targetClassId', 'targetSectionName', 'createdAtIso']) &&
        b.keys().hasOnly([
          'id', 'kind', 'title', 'body', 'targetClassId', 'targetSectionName',
          'subject', 'imageMediaId', 'imageCaption', 'createdAtIso'
        ]) &&
        b.id is string && b.id.size() >= 1 && b.id.size() <= 64 &&
        b.kind in ['announcement', 'grades', 'attendance', 'urgent'] &&
        b.title is string && b.title.size() >= 1 && b.title.size() <= 140 &&
        b.body is string && b.body.size() >= 1 && b.body.size() <= 500 &&
        b.targetClassId is string && b.targetClassId.size() >= 1 && b.targetClassId.size() <= 128 &&
        b.targetSectionName is string && b.targetSectionName.size() >= 1 && b.targetSectionName.size() <= 80 &&
        (!('subject' in b) || (b.subject is string && b.subject.size() <= 80)) &&
        (!('imageMediaId' in b) || isValidId(b.imageMediaId)) &&
        (!('imageCaption' in b) || (b.imageCaption is string && b.imageCaption.size() <= 140)) &&
        b.createdAtIso is string && b.createdAtIso.size() >= 1 && b.createdAtIso.size() <= 40;
    }

    function isValidMediaAttachment(data) {
      return data.keys().hasAll(['ownerId', 'schoolId', 'dataUrl', 'caption', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'schoolId', 'dataUrl', 'caption', 'createdAt']) &&
        isValidId(data.ownerId) &&
        isValidId(data.schoolId) &&
        data.ownerId == data.schoolId &&
        data.dataUrl is string &&
        data.dataUrl.size() >= 32 &&
        data.dataUrl.size() <= 380000 &&
        data.dataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$') &&
        data.caption is string &&
        data.caption.size() <= 140 &&
        data.createdAt is timestamp;
    }

    function isValidPushSubscription(data, expectedScope) {
      return data.keys().hasAll([
          'schoolOwnerId', 'scope', 'sectionId', 'endpoint',
          'p256dh', 'auth', 'deviceLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolOwnerId', 'scope', 'sectionId', 'studentId', 'endpoint',
          'p256dh', 'auth', 'deviceLabel', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.schoolOwnerId) &&
        data.scope == expectedScope &&
        isValidId(data.sectionId) &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
        data.endpoint is string &&
        data.endpoint.size() >= 24 &&
        data.endpoint.size() <= 1000 &&
        data.endpoint.matches('^https://(fcm\\.googleapis\\.com|android\\.googleapis\\.com|updates\\.push\\.services\\.mozilla\\.com|push\\.services\\.mozilla\\.com|web\\.push\\.apple\\.com|[a-z0-9\\-]+\\.push\\.apple\\.com|[a-z0-9\\-]+\\.notify\\.windows\\.com|notify\\.windows\\.com)/.*$') &&
        data.p256dh is string &&
        data.p256dh.size() >= 16 &&
        data.p256dh.size() <= 200 &&
        data.p256dh.matches('^[A-Za-z0-9_\\-+/=]+$') &&
        data.auth is string &&
        data.auth.size() >= 8 &&
        data.auth.size() <= 100 &&
        data.auth.matches('^[A-Za-z0-9_\\-+/=]+$') &&
        data.deviceLabel is string &&
        data.deviceLabel.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidSchool(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'whatsappNumber', 'absenceAlertThreshold',
          'academicYear', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'whatsappNumber', 'absenceAlertThreshold',
          'academicYear', 'stageNames', 'stageTokens', 'subjects',
          'adminPinHash', 'adminPinSalt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidPhone(data.whatsappNumber) &&
        data.absenceAlertThreshold is number && data.absenceAlertThreshold >= 1 && data.absenceAlertThreshold <= 30 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
        (!('stageNames' in data) || isValidStageNamesMap(data.stageNames)) &&
        (!('stageTokens' in data) || isValidStageTokensMap(data.stageTokens)) &&
        (!('subjects' in data) || isValidSubjectsList(data.subjects)) &&
        (('adminPinHash' in data) == ('adminPinSalt' in data)) &&
        (!('adminPinHash' in data) || isValidHex64(data.adminPinHash)) &&
        (!('adminPinSalt' in data) || isValidHex32(data.adminPinSalt)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffMember(data, memberEmail) {
      return data.keys().hasAll([
          'schoolId', 'ownerId', 'email', 'displayName', 'role',
          'addedByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'ownerId', 'email', 'displayName', 'role',
          'addedByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        isValidId(data.ownerId) &&
        data.schoolId == data.ownerId &&
        isValidEmailKey(data.email) &&
        data.email == memberEmail &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.role in ['vice_principal', 'teacher', 'supervisor', 'admin_staff'] &&
        isValidId(data.addedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClassroom(data, schoolId) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'name', 'stage', 'homeroomTeacher', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'stageId', 'name', 'stage', 'homeroomTeacher', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == schoolId &&
        data.schoolId == schoolId &&
        (!('stageId' in data) || isValidStageId(data.stageId)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.stage is string && data.stage.size() >= 1 && data.stage.size() <= 60 &&
        data.homeroomTeacher is string && data.homeroomTeacher.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudent(data, schoolId) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'classId', 'className', 'fullName',
          'studentCode', 'parentName', 'parentPhone', 'passToken', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'stageId', 'classId', 'className', 'fullName',
          'studentCode', 'parentName', 'parentPhone', 'passToken', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == schoolId &&
        data.schoolId == schoolId &&
        (!('stageId' in data) || isValidStageId(data.stageId)) &&
        isValidId(data.classId) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 80 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 32 &&
        data.parentName is string && data.parentName.size() <= 100 &&
        isValidPhone(data.parentPhone) &&
        isValidPassToken(data.passToken) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceLog(data, schoolId) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'classId', 'studentId', 'studentName',
          'date', 'status', 'note', 'notifiedViaWhatsapp', 'notifiedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'stageId', 'classId', 'studentId', 'studentName',
          'date', 'status', 'note', 'notifiedViaWhatsapp', 'notifiedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == schoolId &&
        data.schoolId == schoolId &&
        (!('stageId' in data) || isValidStageId(data.stageId)) &&
        isValidId(data.classId) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        isValidDateString(data.date) &&
        data.status in ['present', 'absent', 'late', 'excused'] &&
        data.note is string && data.note.size() <= 300 &&
        data.notifiedViaWhatsapp is bool &&
        data.notifiedAt is string && data.notifiedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGradeEntry(data, schoolId) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'classId', 'studentId', 'studentName',
          'subject', 'title', 'score', 'maxScore', 'date', 'teacherNote',
          'notifiedViaWhatsapp', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'stageId', 'classId', 'studentId', 'studentName',
          'subject', 'title', 'score', 'maxScore', 'date', 'teacherNote',
          'notifiedViaWhatsapp', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == schoolId &&
        data.schoolId == schoolId &&
        (!('stageId' in data) || isValidStageId(data.stageId)) &&
        isValidId(data.classId) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.score is number && data.score >= 0 && data.score <= 1000 &&
        data.maxScore is number && data.maxScore >= 1 && data.maxScore <= 1000 &&
        data.score <= data.maxScore &&
        isValidDateString(data.date) &&
        data.teacherNote is string && data.teacherNote.size() <= 300 &&
        data.notifiedViaWhatsapp is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentPass(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'studentId', 'schoolName', 'schoolWhatsapp',
          'academicYear', 'studentDisplayName', 'studentCode', 'className',
          'absenceAlertThreshold', 'todayDate', 'todayStatus', 'totalAbsent',
          'totalLate', 'totalExcused', 'averagePercent', 'recentAttendance',
          'recentGrades', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'studentId', 'stageId', 'stageName',
          'schoolName', 'schoolWhatsapp', 'academicYear', 'studentDisplayName',
          'studentCode', 'className', 'absenceAlertThreshold', 'todayDate',
          'todayStatus', 'totalAbsent', 'totalLate', 'totalExcused',
          'averagePercent', 'subjectsCount', 'totalScoreSum', 'totalMaxScoreSum',
          'subjectSummaries', 'latestAlert', 'recentAttendance', 'recentGrades',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.schoolId) &&
        data.ownerId == data.schoolId &&
        isValidId(data.studentId) &&
        (!('stageId' in data) || isValidStageId(data.stageId)) &&
        (!('stageName' in data) || (data.stageName is string && data.stageName.size() <= 60)) &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120 &&
        isValidPhone(data.schoolWhatsapp) &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
        data.studentDisplayName is string && data.studentDisplayName.size() >= 1 && data.studentDisplayName.size() <= 100 &&
        data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 32 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 80 &&
        data.absenceAlertThreshold is number && data.absenceAlertThreshold >= 1 && data.absenceAlertThreshold <= 30 &&
        isValidOptionalDateString(data.todayDate) &&
        data.todayStatus in ['present', 'absent', 'late', 'excused', 'none'] &&
        data.totalAbsent is number && data.totalAbsent >= 0 && data.totalAbsent <= 365 &&
        data.totalLate is number && data.totalLate >= 0 && data.totalLate <= 365 &&
        data.totalExcused is number && data.totalExcused >= 0 && data.totalExcused <= 365 &&
        data.averagePercent is number && data.averagePercent >= 0 && data.averagePercent <= 100 &&
        (!('subjectsCount' in data) || (data.subjectsCount is number && data.subjectsCount >= 0 && data.subjectsCount <= 30)) &&
        (!('totalScoreSum' in data) || (data.totalScoreSum is number && data.totalScoreSum >= 0 && data.totalScoreSum <= 50000)) &&
        (!('totalMaxScoreSum' in data) || (data.totalMaxScoreSum is number && data.totalMaxScoreSum >= 0 && data.totalMaxScoreSum <= 50000)) &&
        (!('subjectSummaries' in data) || (data.subjectSummaries is list && data.subjectSummaries.size() <= 25 && (data.subjectSummaries.size() == 0 || data.subjectSummaries[0] is map))) &&
        (!('latestAlert' in data) || isValidLatestAlert(data.latestAlert)) &&
        data.recentAttendance is list && data.recentAttendance.size() <= 40 &&
        (data.recentAttendance.size() == 0 || data.recentAttendance[0] is map) &&
        data.recentGrades is list && data.recentGrades.size() <= 40 &&
        (data.recentGrades.size() == 0 || data.recentGrades[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStagePortal(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'stageId', 'stageName', 'schoolName',
          'academicYear', 'sections', 'broadcasts', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'stageId', 'stageName', 'schoolName',
          'academicYear', 'sections', 'latestBroadcast', 'broadcasts',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.schoolId) &&
        data.ownerId == data.schoolId &&
        isValidStageId(data.stageId) &&
        data.stageName is string && data.stageName.size() >= 1 && data.stageName.size() <= 60 &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
        data.sections is list && data.sections.size() <= 30 &&
        (data.sections.size() == 0 || data.sections[0] is map) &&
        (!('latestBroadcast' in data) || isValidStageBroadcast(data.latestBroadcast)) &&
        data.broadcasts is list && data.broadcasts.size() <= 40 &&
        (data.broadcasts.size() == 0 || data.broadcasts[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicPortal(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'schoolName', 'academicYear',
          'stageNames', 'stageTokens', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schoolId', 'schoolName', 'academicYear',
          'stageNames', 'stageTokens', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.schoolId) &&
        data.ownerId == data.schoolId &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
        isValidStageNamesMap(data.stageNames) &&
        isValidStageTokensMap(data.stageTokens) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAck(data) {
      return data.keys().hasAll([
          'authorId', 'schoolOwnerId', 'studentId', 'type', 'targetDate',
          'message', 'senderLabel', 'schoolStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId', 'schoolOwnerId', 'studentId', 'type', 'targetDate',
          'message', 'senderLabel', 'schoolStatus', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.authorId) &&
        isValidId(data.schoolOwnerId) &&
        isValidId(data.studentId) &&
        data.type in ['seen', 'excuse'] &&
        isValidOptionalDateString(data.targetDate) &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        data.senderLabel is string && data.senderLabel.size() >= 1 && data.senderLabel.size() <= 80 &&
        data.schoolStatus in ['pending', 'reviewed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Admins registry (read-only by self or admin)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerified() && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // 4b. School Administration Staff Members (RBAC email registry)
    match /staffMembers/{memberEmail} {
      allow get: if isValidEmailKey(memberEmail) && isVerified() && (
        (request.auth.token.email is string && request.auth.token.email.lower() == memberEmail) ||
        (resource != null && existing().ownerId == request.auth.uid) ||
        (resource == null && isSchoolOwner(request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isVerified() &&
        isValidEmailKey(memberEmail) &&
        isValidStaffMember(incoming(), memberEmail) &&
        incoming().ownerId == request.auth.uid &&
        incoming().addedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isSchoolOwner(incoming().schoolId) || isAdmin());

      allow update: if isVerified() &&
        isValidEmailKey(memberEmail) &&
        isValidStaffMember(incoming(), memberEmail) &&
        incoming().schoolId == existing().schoolId &&
        incoming().ownerId == existing().ownerId &&
        incoming().email == existing().email &&
        incoming().addedByUid == existing().addedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
          )
        );

      allow delete: if isVerified() && isValidEmailKey(memberEmail) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
    }

    // 5. Schools & Private School Subcollections
    match /schools/{schoolId} {
      allow get: if isValidId(schoolId) && isVerified() && (
        schoolId == request.auth.uid ||
        (resource != null && existing().ownerId == request.auth.uid) ||
        isSchoolStaff(schoolId) ||
        isAdmin()
      );
      allow list: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isVerified() &&
        isValidId(schoolId) &&
        schoolId == request.auth.uid &&
        isValidSchool(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          !exists(/databases/$(database)/documents/publicPortals/primary) ||
          get(/databases/$(database)/documents/publicPortals/primary).data.ownerId == request.auth.uid ||
          isAdmin()
        );

      allow update: if isVerified() &&
        isValidId(schoolId) &&
        isValidSchool(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || !('adminPinHash' in existing()) || ('adminPinHash' in incoming())) &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'whatsappNumber', 'absenceAlertThreshold', 'academicYear',
              'stageNames', 'stageTokens', 'subjects', 'adminPinHash', 'adminPinSalt', 'updatedAt'
            ])
          ) ||
          (
            isSchoolStaff(schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['subjects', 'updatedAt'])
          )
        );

      allow delete: if isVerified() && isValidId(schoolId) && (existing().ownerId == request.auth.uid || isAdmin());

      // Classrooms (Sections)
      match /classrooms/{classId} {
        allow get: if isValidId(schoolId) && isValidId(classId) && isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );

        allow create: if isVerified() &&
          isValidId(schoolId) && isValidId(classId) &&
          isValidClassroom(incoming(), schoolId) &&
          incoming().ownerId == schoolId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSchoolAccess(schoolId);

        allow update: if isVerified() &&
          isValidId(schoolId) && isValidId(classId) &&
          isValidClassroom(incoming(), schoolId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              hasSchoolAccess(schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'stage', 'stageId', 'homeroomTeacher', 'updatedAt'])
            )
          );

        allow delete: if isVerified() && isValidId(schoolId) && isValidId(classId) && hasSchoolAccess(schoolId);
      }

      // Students (Private PII)
      match /students/{studentId} {
        allow get: if isValidId(schoolId) && isValidId(studentId) && isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );

        allow create: if isVerified() &&
          isValidId(schoolId) && isValidId(studentId) &&
          isValidStudent(incoming(), schoolId) &&
          incoming().ownerId == schoolId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSchoolAccess(schoolId) &&
          existsAfter(/databases/$(database)/documents/schools/$(schoolId)/classrooms/$(incoming().classId));

        allow update: if isVerified() &&
          isValidId(schoolId) && isValidId(studentId) &&
          isValidStudent(incoming(), schoolId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().schoolId == existing().schoolId &&
          incoming().passToken == existing().passToken &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              hasSchoolAccess(schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'stageId', 'classId', 'className', 'fullName', 'studentCode', 'parentName', 'parentPhone', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerified() && isValidId(schoolId) && isValidId(studentId) && hasSchoolAccess(schoolId);
      }

      // Attendance Logs
      match /attendanceLogs/{logId} {
        allow get: if isValidId(schoolId) && isValidId(logId) && isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );

        allow create: if isVerified() &&
          isValidId(schoolId) && isValidId(logId) &&
          isValidAttendanceLog(incoming(), schoolId) &&
          incoming().ownerId == schoolId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSchoolAccess(schoolId) &&
          existsAfter(/databases/$(database)/documents/schools/$(schoolId)/students/$(incoming().studentId));

        allow update: if isVerified() &&
          isValidId(schoolId) && isValidId(logId) &&
          isValidAttendanceLog(incoming(), schoolId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().schoolId == existing().schoolId &&
          incoming().studentId == existing().studentId &&
          incoming().date == existing().date &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              hasSchoolAccess(schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'stageId', 'status', 'note', 'notifiedViaWhatsapp', 'notifiedAt', 'studentName', 'classId', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerified() && isValidId(schoolId) && isValidId(logId) && hasSchoolAccess(schoolId);
      }

      // Grade Entries
      match /gradeEntries/{gradeId} {
        allow get: if isValidId(schoolId) && isValidId(gradeId) && isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid || isSchoolStaff(schoolId) || isAdmin()
        );

        allow create: if isVerified() &&
          isValidId(schoolId) && isValidId(gradeId) &&
          isValidGradeEntry(incoming(), schoolId) &&
          incoming().ownerId == schoolId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSchoolAccess(schoolId) &&
          existsAfter(/databases/$(database)/documents/schools/$(schoolId)/students/$(incoming().studentId));

        allow update: if isVerified() &&
          isValidId(schoolId) && isValidId(gradeId) &&
          isValidGradeEntry(incoming(), schoolId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().schoolId == existing().schoolId &&
          incoming().studentId == existing().studentId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              hasSchoolAccess(schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'stageId', 'subject', 'title', 'score', 'maxScore', 'date', 'teacherNote', 'notifiedViaWhatsapp', 'studentName', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerified() && isValidId(schoolId) && isValidId(gradeId) && hasSchoolAccess(schoolId);
      }
    }

    // 6. PII-Free Public Capability-Token Student Passes (Zero-Login Parent Access)
    match /passes/{passToken} {
      allow get: if isValidPassToken(passToken);
      allow list: if false;

      allow create: if isVerified() &&
        isValidPassToken(passToken) &&
        isValidStudentPass(incoming()) &&
        incoming().ownerId == incoming().schoolId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasSchoolAccess(incoming().schoolId) &&
        existsAfter(/databases/$(database)/documents/schools/$(incoming().schoolId)/students/$(incoming().studentId));

      allow update: if isVerified() &&
        isValidPassToken(passToken) &&
        isValidStudentPass(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().schoolId == existing().schoolId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            hasSchoolAccess(existing().schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stageId', 'stageName', 'schoolName', 'schoolWhatsapp', 'academicYear',
              'studentDisplayName', 'studentCode', 'className', 'absenceAlertThreshold',
              'todayDate', 'todayStatus', 'totalAbsent', 'totalLate', 'totalExcused',
              'averagePercent', 'subjectsCount', 'totalScoreSum', 'totalMaxScoreSum',
              'subjectSummaries', 'latestAlert', 'recentAttendance', 'recentGrades', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() && isValidPassToken(passToken) && hasSchoolAccess(existing().schoolId);

      // Parent Read-Receipts & Absence Excuses
      match /acknowledgements/{ackId} {
        allow get: if isValidPassToken(passToken) && isValidId(ackId) && isVerified() && (
          existing().authorId == request.auth.uid ||
          existing().schoolOwnerId == request.auth.uid ||
          isSchoolStaff(existing().schoolOwnerId) ||
          isAdmin()
        );

        allow list: if isVerified() && (
          existing().authorId == request.auth.uid ||
          existing().schoolOwnerId == request.auth.uid ||
          isSchoolStaff(existing().schoolOwnerId) ||
          isAdmin()
        );

        allow create: if isVerified() &&
          isValidPassToken(passToken) && isValidId(ackId) &&
          isValidAck(incoming()) &&
          incoming().authorId == request.auth.uid &&
          incoming().schoolStatus == 'pending' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/passes/$(passToken)) &&
          incoming().schoolOwnerId == get(/databases/$(database)/documents/passes/$(passToken)).data.ownerId &&
          incoming().studentId == get(/databases/$(database)/documents/passes/$(passToken)).data.studentId;

        allow update: if isVerified() &&
          isValidPassToken(passToken) && isValidId(ackId) &&
          isValidAck(incoming()) &&
          incoming().authorId == existing().authorId &&
          incoming().schoolOwnerId == existing().schoolOwnerId &&
          incoming().studentId == existing().studentId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              (existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId)) &&
              existing().schoolStatus != 'reviewed' &&
              incoming().schoolStatus == 'reviewed' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['schoolStatus', 'updatedAt'])
            )
          );

        allow delete: if isVerified() && isValidPassToken(passToken) && isValidId(ackId) && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );
      }

      // Private Image Attachments sent exclusively to a specific student's parent pass
      match /media/{mediaId} {
        allow get: if isValidPassToken(passToken) && isValidId(mediaId);
        allow list: if false;

        allow create: if isVerified() &&
          isValidPassToken(passToken) && isValidId(mediaId) &&
          isValidMediaAttachment(incoming()) &&
          incoming().ownerId == incoming().schoolId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/passes/$(passToken)) &&
          get(/databases/$(database)/documents/passes/$(passToken)).data.schoolId == incoming().schoolId &&
          hasSchoolAccess(incoming().schoolId);

        allow update: if false;

        allow delete: if isVerified() && isValidPassToken(passToken) && isValidId(mediaId) && hasSchoolAccess(existing().schoolId);
      }

      // External Web Push Subscriptions registered by a student's parent device (zero-login subscribe; school admin read/delete)
      match /pushSubscriptions/{subId} {
        allow get: if isValidPassToken(passToken) && isValidSubId(subId) && isVerified() && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );

        allow create: if isValidPassToken(passToken) && isValidSubId(subId) &&
          isValidPushSubscription(incoming(), 'pass') &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/passes/$(passToken)) &&
          incoming().schoolOwnerId == get(/databases/$(database)/documents/passes/$(passToken)).data.ownerId &&
          incoming().studentId == get(/databases/$(database)/documents/passes/$(passToken)).data.studentId;

        allow update: if isValidPassToken(passToken) && isValidSubId(subId) &&
          isValidPushSubscription(incoming(), 'pass') &&
          incoming().schoolOwnerId == existing().schoolOwnerId &&
          incoming().scope == existing().scope &&
          incoming().studentId == existing().studentId &&
          incoming().endpoint == existing().endpoint &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['p256dh', 'auth', 'deviceLabel', 'updatedAt']);

        allow delete: if isVerified() && isValidPassToken(passToken) && isValidSubId(subId) && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );
      }
    }

    // 7. PII-Free Stage QR Portals (Instant In-Website Collective Notifications per Stage)
    match /stagePortals/{stageToken} {
      allow get: if isValidPassToken(stageToken);
      allow list: if false;

      allow create: if isVerified() &&
        isValidPassToken(stageToken) &&
        isValidStagePortal(incoming()) &&
        incoming().ownerId == incoming().schoolId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasSchoolAccess(incoming().schoolId);

      allow update: if isVerified() &&
        isValidPassToken(stageToken) &&
        isValidStagePortal(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().schoolId == existing().schoolId &&
        incoming().stageId == existing().stageId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            hasSchoolAccess(existing().schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stageName', 'schoolName', 'academicYear', 'sections',
              'latestBroadcast', 'broadcasts', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() && isValidPassToken(stageToken) && (
        isSchoolOwner(existing().schoolId) || isAdmin()
      );

      // Compressed Image Attachments linked to collective stage/section broadcasts
      match /media/{mediaId} {
        allow get: if isValidPassToken(stageToken) && isValidId(mediaId);
        allow list: if false;

        allow create: if isVerified() &&
          isValidPassToken(stageToken) && isValidId(mediaId) &&
          isValidMediaAttachment(incoming()) &&
          incoming().ownerId == incoming().schoolId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/stagePortals/$(stageToken)) &&
          get(/databases/$(database)/documents/stagePortals/$(stageToken)).data.schoolId == incoming().schoolId &&
          hasSchoolAccess(incoming().schoolId);

        allow update: if false;

        allow delete: if isVerified() && isValidPassToken(stageToken) && isValidId(mediaId) && hasSchoolAccess(existing().schoolId);
      }

      // External Web Push Subscriptions registered by parents on this Stage QR Portal
      match /pushSubscriptions/{subId} {
        allow get: if isValidPassToken(stageToken) && isValidSubId(subId) && isVerified() && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );
        allow list: if isVerified() && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );

        allow create: if isValidPassToken(stageToken) && isValidSubId(subId) &&
          isValidPushSubscription(incoming(), 'stage') &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/stagePortals/$(stageToken)) &&
          incoming().schoolOwnerId == get(/databases/$(database)/documents/stagePortals/$(stageToken)).data.ownerId;

        allow update: if isValidPassToken(stageToken) && isValidSubId(subId) &&
          isValidPushSubscription(incoming(), 'stage') &&
          incoming().schoolOwnerId == existing().schoolOwnerId &&
          incoming().scope == existing().scope &&
          incoming().endpoint == existing().endpoint &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['sectionId', 'p256dh', 'auth', 'deviceLabel', 'updatedAt']);

        allow delete: if isVerified() && isValidPassToken(stageToken) && isValidSubId(subId) && (
          existing().schoolOwnerId == request.auth.uid || isSchoolStaff(existing().schoolOwnerId) || isAdmin()
        );
      }
    }

    // 8. PII-Free Public Parents Portal Stage Directory
    match /publicPortals/{portalId} {
      allow get: if isValidId(portalId);
      allow list: if false;

      allow create: if isVerified() &&
        isValidId(portalId) &&
        isValidPublicPortal(incoming()) &&
        incoming().ownerId == incoming().schoolId &&
        (portalId == incoming().schoolId || portalId == 'primary') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isSchoolOwner(incoming().schoolId) || isAdmin());

      allow update: if isVerified() &&
        isValidId(portalId) &&
        isValidPublicPortal(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().schoolId == existing().schoolId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isSchoolOwner(existing().schoolId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'schoolName', 'academicYear', 'stageNames', 'stageTokens', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() && isValidId(portalId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
